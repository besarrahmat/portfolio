{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --dir src --passWithNoTests",
    "test:e2e": "playwright test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "[ \"$(git branch --show-current)\" = main ] || { echo 'Deploy only from main (development happens on dev).' >&2; exit 1; }; opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "size:dry-run": "opennextjs-cloudflare build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/server/db/seed.ts --local",
    "db:seed:remote": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/server/db/seed.ts --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "husky": "9.1.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261019.1": true
  },
  "engines": {
    "node": ">=24 <25"
  }
}
