{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // shortcut: workers.dev only while there is no domain (Fase 0 tracer); MUST be false before real manage code ships (Fase 8)
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-db",
      "database_id": "b6df9075-ee90-4a24-a074-2d5930156ec7",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "portfolio-media"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "portfolio-cache"
    }
  ],
  // v1 created the OpenNext DO queue; v2 deletes it (unused since 'use cache' was dropped, and worker.js no longer exports it).
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["DOQueueHandler"]
    }
  ]
}
