{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // shortcut: workers.dev only while there is no domain (Fase 0 tracer); MUST be false before real manage code ships (Fase 8)
  "workers_dev": true,
  "preview_urls": false,
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "portfolio" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-db",
      "database_id": "REPLACE_WITH_portfolio-db_ID",
      "migrations_dir": "./drizzle"
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "portfolio-tag-cache",
      "database_id": "REPLACE_WITH_portfolio-tag-cache_ID"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "portfolio-media" },
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "portfolio-cache" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }]
}
